    "shortcuts": [
        {
            "name": "New Order",
            "short_name": "Order",
            "description": "Create a new order",
            "url": "/orders/new?source=pwa",
            "icons": [
                {
                    "src": "/static/images/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Menu Management",
            "short_name": "Menu",
            "description": "View and manage menu items",
            "url": "/menu?source=pwa",
            "icons": [
                {
                    "src": "/static/images/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Kitchen Display",
            "short_name": "Kitchen",
            "description": "Kitchen display system",
            "url": "/kitchen?source=pwa",
            "icons": [
                {
                    "src": "/static/images/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Inventory",
            "short_name": "Stock",
            "description": "Manage inventory levels",
            "url": "/inventory?source=pwa",
            "icons": [
                {
                    "src": "/static/images/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Reports",
            "short_name": "Reports",
            "description": "View business reports",
            "url": "/reports?source=pwa",
            "icons": [
                {
                    "src": "/static/images/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "screenshots": [
        {
            "src": "/static/images/screenshot-mobile.png",
            "sizes": "390x844",
            "type": "image/png",
            "form_factor": "narrow"
        },
        {
            "src": "/static/images/screenshot-desktop.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide"
        }
    ],
    "related_applications": [],
    "edge_side_panel": {
        "preferred_width": 400
    },
    "launch_handler": {
        "client_mode": "focus-existing"
    },
    "protocol_handlers": [
        {
            "protocol": "web+pos",
            "url": "/orders/new?order=%s"
        }
    ],
    "share_target": {
        "action": "/orders/new",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "order_title",
            "text": "order_notes",
            "url": "order_url",
            "files": [
                {
                    "name": "order_file",
                    "accept": ["image/*", ".pdf"]
                }
            ]
        }
    },
    "file_handlers": [
        {
            "action": "/orders/import",
            "accept": {
                "application/json": [".json"]
            }
        }
    ],
    "handle_links": "preferred",
    "capture_links": "existing-client-navigate",
    "scope_extensions": [
        "/api/",
        "/static/"
    ]
}